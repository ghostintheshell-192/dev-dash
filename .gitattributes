# Auto detect text files and perform LF normalization
* text=auto

# Source code - always LF in repo
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cmake text eol=lf
*.py text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Config files
*.config text eol=lf
*.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Scripts - platform specific
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf

# Fully derived documentation
#
# A generator owns these two files end to end, so when both sides of a merge
# have regenerated them there is nothing to reconcile: keep either side and let
# .githooks/post-merge regenerate from the merged tree. Without this, two
# branches that each added a tech-debt issue or a spec conflict on files that
# are about to be rewritten wholesale.
#
# The `generated` driver is registered per clone by
# .development/automation/bootstrap.sh, next to core.hooksPath — without the
# hooks, this attribute would silently keep one side and never regenerate.
#
# .development/tech-debt/README.md is deliberately absent: a generator owns one
# section of it and the surrounding prose is hand-written, so keeping one side
# would discard the other's edits and regeneration would not restore them.
# Its conflicts are real and have to be read.
.development/ARCHITECTURE.md merge=generated
.development/INDEX.md merge=generated

# Binary files - no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.ttf binary
*.otf binary
