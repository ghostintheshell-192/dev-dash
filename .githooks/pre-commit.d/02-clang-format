#!/bin/bash
# Pre-commit Hook Module: C++ Code Formatting
# Runs clang-format on staged C/C++ files and fails if any produce a diff.
# Skips silently if the project has no `.clang-format` at root (so the hook
# stays inert until the user opts in by adding the config).

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)

# Skip silently if the project hasn't opted in yet.
if [[ ! -f "$PROJECT_ROOT/.clang-format" ]]; then
    exit 0
fi

# Get list of staged C/C++ files (added/copied/modified).
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '\.(c|cc|cpp|cxx|h|hpp|hxx)$' || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo -e "${GREEN}[C++ Format Check]${NC} Running clang-format..."

if ! command -v clang-format &> /dev/null; then
    echo -e "${YELLOW}⚠ WARNING:${NC} clang-format command not found - skipping format check"
    exit 0
fi

# Verify each staged file matches what clang-format would produce.
FAILED_FILES=()
while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    if ! diff -q <(clang-format "$file") "$file" > /dev/null 2>&1; then
        FAILED_FILES+=("$file")
    fi
done <<< "$STAGED_FILES"

if [ ${#FAILED_FILES[@]} -ne 0 ]; then
    echo ""
    echo -e "${RED}═══════════════════════════════════════════════${NC}"
    echo -e "${RED}  C++ CODE NOT FORMATTED CORRECTLY!${NC}"
    echo -e "${RED}═══════════════════════════════════════════════${NC}"
    echo ""
    echo "Files with formatting issues:"
    for f in "${FAILED_FILES[@]}"; do
        echo "  - $f"
    done
    echo ""
    echo -e "${YELLOW}To fix:${NC}"
    echo "  clang-format -i <file>          # auto-fix one file"
    echo "  clang-format -i \$(git diff --cached --name-only --diff-filter=ACM | grep -E '\\.(c|cc|cpp|cxx|h|hpp|hxx)\$')"
    echo ""
    echo -e "${YELLOW}To bypass (NOT RECOMMENDED):${NC}"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo -e "${GREEN}✓ C++ code formatted correctly${NC}"
exit 0
