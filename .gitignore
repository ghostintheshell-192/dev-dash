# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Editor leftovers / backups
*.bak
backups/

# Logs
*.log
build_log.txt
app_output.log
logs/

# Code signing certificates - NEVER commit private keys!
*.key
*.pfx
*.p12

# Sample files / test data
samples/

# Private folders (not committed)
.personal/
.secrets/

# Session handoffs (selectively ignored, see .memory-bank/.gitignore)
.memory-bank/sessions/

# Legacy binary archives in development archive
.development/archive/legacy/*.zip

# Claude Code local overrides
**/claude-todos*.md
**/temp-todos*.md
.claude/settings.local.json
.claude/*.local.md

# C++ build artifacts
# poc/.gitignore already handles poc/build/; these patterns catch stragglers
# anywhere else in the tree (e.g., out-of-tree CMake builds, IDE-driven builds).
build/
*.o
*.a
*.so
*.dylib
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
