#!/bin/bash
# Archive Resolved Tech Debt Issues
# Automatically moves resolved/closed/rejected issues from .development/tech-debt/
# to .development/archive/completed/.
# Part of pre-commit hook chain.

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${GREEN}[Archive Resolved Issues]${NC} Checking for resolved tech debt issues..."

# Find the repository root
REPO_ROOT=$(git rev-parse --show-toplevel)

# Check if .development/tech-debt/ exists
if [ ! -d "$REPO_ROOT/.development/tech-debt" ]; then
    echo -e "${GREEN}✓ No tech-debt directory${NC} - skipping archive check"
    exit 0
fi

TECH_DEBT_DIR="$REPO_ROOT/.development/tech-debt"
ARCHIVE_DIR="$REPO_ROOT/.development/archive/completed"
CURRENT_DATE=$(date +%Y-%m-%d)

# Date to prefix the archived filename with, read from the issue's own
# frontmatter. What a reader wants from that prefix is when the issue was
# closed, not when someone got round to moving the file: git already records
# the move, and the two can be months apart when an issue is archived late.
# Prefers `resolved:`, falls back to `closed:`, and only then to today —
# which the caller announces rather than passing off as a closure date.
closure_date() {
    local path="$1" field value
    for field in resolved closed; do
        value=$(grep -m 1 -E "^${field}: *[0-9]{4}-[0-9]{2}-[0-9]{2}" "$path" 2>/dev/null \
            | sed -E "s/^${field}: *//" | tr -d ' \r')
        if [ -n "$value" ]; then
            printf '%s' "$value"
            return 0
        fi
    done
    printf '%s' "$CURRENT_DATE"
    return 1
}

# Get list of staged files in tech-debt/ (only check files being committed)
STAGED_TECH_DEBT=$(git diff --cached --name-only --diff-filter=AM | grep "^\.development/tech-debt/.*\.md$" || true)

if [ -z "$STAGED_TECH_DEBT" ]; then
    echo -e "${GREEN}✓ No tech-debt issues staged${NC}"
    exit 0
fi

MOVED_COUNT=0

while IFS= read -r file; do
    FULL_PATH="$REPO_ROOT/$file"
    FILENAME=$(basename "$file")

    # Skip template and README
    if [ "$FILENAME" = "_TEMPLATE.md" ] || [ "$FILENAME" = "README.md" ]; then
        continue
    fi

    # Extract status from YAML frontmatter
    STATUS=$(grep -m 1 "^status:" "$FULL_PATH" 2>/dev/null | sed 's/status: *//' | tr -d ' \r\n')

    if [ "$STATUS" = "resolved" ] || [ "$STATUS" = "closed" ] || [ "$STATUS" = "rejected" ]; then
        # Check if filename already has date prefix (YYYY-MM-DD_)
        DATE_NOTE=""
        if [[ ! "$FILENAME" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}_ ]]; then
            if ! ISSUE_DATE=$(closure_date "$FULL_PATH"); then
                DATE_NOTE=" ${YELLOW}[no closure date in frontmatter — used today]${NC}"
            fi
            NEW_FILENAME="${ISSUE_DATE}_${FILENAME}"
        else
            NEW_FILENAME="$FILENAME"
        fi

        NEW_PATH="$ARCHIVE_DIR/$NEW_FILENAME"

        mkdir -p "$ARCHIVE_DIR"

        # Never overwrite an existing archived issue. The manual
        # archive-resolved-issues.sh has always guarded this; the hook did not.
        if [ -f "$NEW_PATH" ]; then
            echo -e "${YELLOW}  ⚠ Skipped:${NC} $FILENAME (already exists in archive)"
            continue
        fi

        mv "$FULL_PATH" "$NEW_PATH"

        # Stage BOTH sides of the move: the removal of the original and the
        # addition of the archived copy. `git reset HEAD "$file"` only unstages
        # the modification — it leaves the original tracked at its HEAD content
        # while absent from disk, so the commit carries the issue twice and the
        # deletion is silently dropped. See
        # tech-debt/archive-hook-loses-the-deletion.md.
        git add -A -- "$FULL_PATH" "$NEW_PATH"

        MOVED_COUNT=$((MOVED_COUNT + 1))
        echo -e "${BLUE}  ↪ Archived:${NC} $FILENAME → ${NEW_FILENAME} (status: $STATUS)${DATE_NOTE}"
    fi
done <<< "$STAGED_TECH_DEBT"

if [ $MOVED_COUNT -gt 0 ]; then
    echo -e "${GREEN}✓ Archived $MOVED_COUNT resolved issue(s)${NC}"
    echo -e "${YELLOW}Note:${NC} Files moved to .development/archive/completed/"
else
    echo -e "${GREEN}✓ No resolved issues to archive${NC}"
fi

exit 0
