# Universal gitignore template
# Language-specific patterns will be added based on project type

## IDE / Editors
.vscode/
.vs/
.idea/
*.swp
*.swo
*~
.DS_Store

## Build outputs (common patterns)
bin/
obj/
build/
dist/
target/
out/

## Dependencies (common patterns)
node_modules/
venv/
env/
.venv/
packages/

## Secrets and environment
.env
.env.local
.env.*.local
.secrets/
*.key
*.pfx
secrets.json

## Samples and test data
samples/

## Logs
*.log
logs/

## Temporary files
*.tmp
*.temp
*.cache

## OS files
Thumbs.db
.DS_Store
Desktop.ini

# Language-specific patterns will be appended here based on project type detected