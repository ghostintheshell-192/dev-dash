<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DevDash"
             xmlns:converters="using:DevDash.Converters"
             x:Class="DevDash.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <converters:PriorityToBrushConverter x:Key="PriorityToBrushConverter"/>
        <converters:PriorityToForegroundConverter x:Key="PriorityToForegroundConverter"/>
        <converters:PriorityIsNotNoneConverter x:Key="PriorityIsNotNoneConverter"/>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <converters:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
        <converters:EnumNotEqualsConverter x:Key="EnumNotEqualsConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
