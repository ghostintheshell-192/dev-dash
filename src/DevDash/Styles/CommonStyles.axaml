<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Common Styles - Buttons, Borders, Tabs, and general UI components
    -->

    <!-- Accent button -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentDim}"/>
        <Setter Property="Foreground" Value="#000000"/>
    </Style>
    <Style Selector="Button.accent:pointerover">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- Sidebar button -->
    <Style Selector="Button.sidebar-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.sidebar-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
    </Style>

    <!-- Tab button -->
    <Style Selector="Button.tab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="4,4,0,0"/>
    </Style>
    <Style Selector="Button.tab:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.tab.active">
        <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- Project item -->
    <Style Selector="Border.project-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.project-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
    </Style>
    <Style Selector="Border.project-item.selected">
        <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BgSelectedBorder}"/>
    </Style>

    <!-- File tree item -->
    <Style Selector="Button.tree-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.tree-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
    </Style>
    <Style Selector="Button.tree-item.selected">
        <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
    </Style>

    <!-- Document tab -->
    <Style Selector="Border.doc-tab">
        <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
        <Setter Property="CornerRadius" Value="6,6,0,0"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="BorderThickness" Value="1,1,1,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.doc-tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgTertiary}"/>
    </Style>
    <Style Selector="Border.doc-tab.selected">
        <Setter Property="Background" Value="{DynamicResource BgDeep}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BgTertiary}"/>
    </Style>

    <!-- Close button on tabs -->
    <Style Selector="Button.tab-close">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tab-close:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgTertiary}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- Priority badges -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>
    <Style Selector="Border.badge-high">
        <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
    </Style>
    <Style Selector="Border.badge-medium">
        <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
    </Style>
    <Style Selector="Border.badge-low">
        <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
    </Style>

    <!-- Status badges -->
    <Style Selector="Border.badge-open">
        <Setter Property="Background" Value="{DynamicResource AccentBg}"/>
    </Style>
    <Style Selector="Border.badge-in-progress">
        <Setter Property="Background" Value="{DynamicResource InfoBg}"/>
    </Style>
    <Style Selector="Border.badge-resolved">
        <Setter Property="Background" Value="{DynamicResource BgTertiary}"/>
    </Style>

    <!-- Breadcrumb -->
    <Style Selector="TextBlock.breadcrumb">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontFamily" Value="Consolas,monospace"/>
    </Style>

    <!-- Specialized tab list item -->
    <Style Selector="Border.tab-list-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.tab-list-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
    </Style>

</Styles>
