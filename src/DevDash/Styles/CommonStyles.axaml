<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Common Styles - Buttons, Borders, Tabs, and general UI components
    -->

    <!-- Accent button -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="#d97706"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.accent:pointerover">
        <Setter Property="Background" Value="#f59e0b"/>
    </Style>

    <!-- Sidebar button -->
    <Style Selector="Button.sidebar-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.sidebar-btn:pointerover">
        <Setter Property="Background" Value="#1e293b"/>
    </Style>

    <!-- Tab button -->
    <Style Selector="Button.tab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#94a3b8"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="4,4,0,0"/>
    </Style>
    <Style Selector="Button.tab:pointerover">
        <Setter Property="Foreground" Value="#e2e8f0"/>
    </Style>
    <Style Selector="Button.tab.active">
        <Setter Property="Background" Value="#1e293b"/>
        <Setter Property="Foreground" Value="#fbbf24"/>
    </Style>

    <!-- Project item -->
    <Style Selector="Border.project-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.project-item:pointerover">
        <Setter Property="Background" Value="#1e293b"/>
    </Style>
    <Style Selector="Border.project-item.selected">
        <Setter Property="Background" Value="#451a03"/>
        <Setter Property="BorderBrush" Value="#92400e"/>
    </Style>

    <!-- File tree item -->
    <Style Selector="Button.tree-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.tree-item:pointerover">
        <Setter Property="Background" Value="#334155"/>
    </Style>
    <Style Selector="Button.tree-item.selected">
        <Setter Property="Background" Value="#451a03"/>
    </Style>

    <!-- Document tab -->
    <Style Selector="Border.doc-tab">
        <Setter Property="Background" Value="#1e293b"/>
        <Setter Property="CornerRadius" Value="6,6,0,0"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="BorderThickness" Value="1,1,1,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.doc-tab:pointerover">
        <Setter Property="Background" Value="#334155"/>
    </Style>
    <Style Selector="Border.doc-tab.selected">
        <Setter Property="Background" Value="#0f172a"/>
        <Setter Property="BorderBrush" Value="#334155"/>
    </Style>

    <!-- Close button on tabs -->
    <Style Selector="Button.tab-close">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#64748b"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tab-close:pointerover">
        <Setter Property="Background" Value="#475569"/>
        <Setter Property="Foreground" Value="#e2e8f0"/>
    </Style>

    <!-- Priority badges -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>
    <Style Selector="Border.badge-high">
        <Setter Property="Background" Value="#7f1d1d"/>
    </Style>
    <Style Selector="Border.badge-medium">
        <Setter Property="Background" Value="#78350f"/>
    </Style>
    <Style Selector="Border.badge-low">
        <Setter Property="Background" Value="#1e293b"/>
    </Style>

    <!-- Status badges -->
    <Style Selector="Border.badge-open">
        <Setter Property="Background" Value="#14532d"/>
    </Style>
    <Style Selector="Border.badge-in-progress">
        <Setter Property="Background" Value="#1e3a5f"/>
    </Style>
    <Style Selector="Border.badge-resolved">
        <Setter Property="Background" Value="#334155"/>
    </Style>

    <!-- Breadcrumb -->
    <Style Selector="TextBlock.breadcrumb">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#64748b"/>
        <Setter Property="FontFamily" Value="Consolas,monospace"/>
    </Style>

    <!-- Specialized tab list item -->
    <Style Selector="Border.tab-list-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.tab-list-item:pointerover">
        <Setter Property="Background" Value="#1e293b"/>
    </Style>

</Styles>
