<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Style Index - Aggregates all style dictionaries
        To add new styles: create a new .axaml file and add it here
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DevDash/Styles/ColorPalette.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <StyleInclude Source="avares://DevDash/Styles/CommonStyles.axaml"/>
</Styles>
