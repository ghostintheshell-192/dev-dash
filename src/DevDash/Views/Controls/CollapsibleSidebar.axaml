<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="DevDash.Views.Controls.CollapsibleSidebar">

    <UserControl.Styles>
        <!-- Icon button style -->
        <Style Selector="Button.sidebar-icon">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.sidebar-icon:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
        </Style>
        <Style Selector="Button.sidebar-icon.active">
            <Setter Property="Background" Value="{DynamicResource BgPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="48,Auto">
        <!-- Icon Bar -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgDeep}"
                BorderBrush="{DynamicResource BgTertiary}"
                BorderThickness="0,0,1,0">
            <Button x:Name="IconButton"
                    Classes="sidebar-icon"
                    VerticalAlignment="Top"/>
        </Border>

        <!-- Content Area -->
        <Border Grid.Column="1"
                x:Name="ContentArea"
                Background="{DynamicResource BgPrimary}"
                BorderBrush="{DynamicResource BgTertiary}"
                BorderThickness="0,0,1,0">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <ContentControl x:Name="SidebarContentControl"/>
        </Border>
    </Grid>
</UserControl>
