<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:DevDash.Models"
             xmlns:controls="using:DevDash.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
             x:Class="DevDash.Views.Controls.MultiSidebar"
             x:Name="Root">

    <UserControl.Styles>
        <!-- Icon button style -->
        <Style Selector="Button.sidebar-icon">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.sidebar-icon:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
        </Style>
        <Style Selector="Button.sidebar-icon.active">
            <Setter Property="Background" Value="{DynamicResource BgPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="48,*">
        <!-- Icon Bar -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgDeep}"
                BorderBrush="{DynamicResource BgTertiary}"
                BorderThickness="0,0,1,0">
            <ItemsControl x:Name="IconBar"
                          ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=controls:MultiSidebar}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="0"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SidebarItem">
                        <Button Classes="sidebar-icon"
                                Classes.active="{Binding IsOpen}"
                                ToolTip.Tip="{Binding Tooltip}"
                                Command="{Binding ToggleSidebarCommand, RelativeSource={RelativeSource AncestorType=controls:MultiSidebar}}"
                                CommandParameter="{Binding}">
                            <PathIcon Data="{Binding IconData}"
                                      Width="20"
                                      Height="20"
                                      Foreground="{DynamicResource TextSecondary}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Sidebar Content Area -->
        <ItemsControl Grid.Column="1"
                      x:Name="ContentArea"
                      ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=controls:MultiSidebar}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="0"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="SidebarBorder"
                            x:DataType="models:SidebarItem"
                            Background="{DynamicResource BgPrimary}"
                            BorderBrush="{DynamicResource BgTertiary}"
                            BorderThickness="0,0,1,0"
                            Width="{Binding Width}"
                            IsVisible="{Binding IsOpen}">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Border.Transitions>
                        <DockPanel>
                            <!-- Collapse button header -->
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BgTertiary}"
                                    BorderThickness="0,0,0,1" Padding="4">
                                <Button HorizontalAlignment="Right"
                                        Background="Transparent" Padding="6,2" CornerRadius="4"
                                        ToolTip.Tip="Collapse"
                                        Command="{Binding ToggleSidebarCommand, RelativeSource={RelativeSource AncestorType=controls:MultiSidebar}}"
                                        CommandParameter="{Binding}">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
                                        </Style>
                                    </Button.Styles>
                                    <TextBlock Text="&#xAB;" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                                </Button>
                            </Border>
                            <ContentControl Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=controls:MultiSidebar}}"
                                            ContentTemplate="{Binding ContentTemplate}"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
