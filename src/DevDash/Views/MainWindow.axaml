<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DevDash.ViewModels"
        xmlns:views="using:DevDash.Views"
        xmlns:controls="using:DevDash.Views.Controls"
        xmlns:models="using:DevDash.Models"
        xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="DevDash.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DevDash"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        Background="{DynamicResource BgDeep}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="40,*">
        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgPrimary}" BorderBrush="{DynamicResource BgTertiary}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left section -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="8,0">
                    <Button Classes="sidebar-btn" Command="{Binding ToggleSidebarCommand}">
                        <PathIcon Data="M3 3h8v18H3zM13 3h8v18h-8z" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}"/>
                    </Button>
                    <Border Width="1" Height="20" Background="{DynamicResource BgTertiary}"/>
                    <TextBlock Text="DevDash" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center section -->
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedProject.Name, FallbackValue=''}"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Right section (reserved for future actions) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0">
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <!-- Sidebar Column -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" ClipToBounds="True">

                <!-- Top: File tree sidebars (.personal, .development, docs) -->
                <controls:MultiSidebar Grid.Row="0"
                                       AllowMultipleOpen="False"
                                       ClipToBounds="True"
                                       DataContext="{Binding}">
                <controls:MultiSidebar.Items>
                    <!-- .personal sidebar -->
                    <models:SidebarItem IconData="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"
                                        Tooltip=".personal"
                                        IsOpen="True"
                                        Width="256">
                        <models:SidebarItem.ContentTemplate>
                            <DataTemplate x:DataType="vm:MainWindowViewModel">
                                <ScrollViewer Padding="8">
                                    <views:FileTreeView ItemsSource="{Binding FileTree}"
                                                        SelectedItem="{Binding SelectedFile, Mode=TwoWay}"/>
                                </ScrollViewer>
                            </DataTemplate>
                        </models:SidebarItem.ContentTemplate>
                    </models:SidebarItem>

                    <!-- .development sidebar -->
                    <models:SidebarItem IconData="M16 18l6-6-6-6M8 6l-6 6 6 6"
                                        Tooltip=".development"
                                        IsOpen="False"
                                        Width="256">
                        <models:SidebarItem.ContentTemplate>
                            <DataTemplate x:DataType="vm:MainWindowViewModel">
                                <ScrollViewer Padding="8">
                                    <views:FileTreeView ItemsSource="{Binding DevelopmentTree}"
                                                        SelectedItem="{Binding SelectedFile, Mode=TwoWay}"/>
                                </ScrollViewer>
                            </DataTemplate>
                        </models:SidebarItem.ContentTemplate>
                    </models:SidebarItem>

                    <!-- docs sidebar -->
                    <models:SidebarItem IconData="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2zM22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"
                                        Tooltip="docs"
                                        IsOpen="False"
                                        Width="256">
                        <models:SidebarItem.ContentTemplate>
                            <DataTemplate x:DataType="vm:MainWindowViewModel">
                                <ScrollViewer Padding="8">
                                    <views:FileTreeView ItemsSource="{Binding DocsTree}"
                                                        SelectedItem="{Binding SelectedFile, Mode=TwoWay}"/>
                                </ScrollViewer>
                            </DataTemplate>
                        </models:SidebarItem.ContentTemplate>
                    </models:SidebarItem>

                </controls:MultiSidebar.Items>
                </controls:MultiSidebar>

                <!-- Bottom: Projects sidebar (anchored above settings) -->
                <controls:MultiSidebar Grid.Row="1"
                                       AllowMultipleOpen="False"
                                       ClipToBounds="True"
                                       DataContext="{Binding}">
                <controls:MultiSidebar.Items>
                    <models:SidebarItem IconData="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                                        Tooltip="Projects"
                                        IsOpen="False"
                                        Width="256">
                        <models:SidebarItem.ContentTemplate>
                            <DataTemplate x:DataType="vm:MainWindowViewModel">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" BorderBrush="{DynamicResource BgTertiary}" BorderThickness="0,0,0,1" Padding="8">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ItemsControl ItemsSource="{Binding Workspaces}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectWorkspaceCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,6" CornerRadius="4" FontSize="12">
                                                <Button.Styles>
                                                    <Style Selector="Button">
                                                        <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                    </Style>
                                                    <Style Selector="Button:pointerover">
                                                        <Setter Property="Background" Value="{DynamicResource BgTertiary}"/>
                                                    </Style>
                                                </Button.Styles>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding Icon}"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" Padding="8">
                            <StackPanel>
                                <TextBlock Text="PROJECTS" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,8" LetterSpacing="1"/>
                                <ItemsControl ItemsSource="{Binding Projects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProjectViewModel">
                                            <Border Classes="project-item"
                                                    Classes.selected="{Binding IsSelected}"
                                                    PointerPressed="OnProjectClicked">
                                                <StackPanel>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13"/>
                                                            <Border Background="{DynamicResource BgTertiary}" CornerRadius="3" Padding="4,1" IsVisible="{Binding Language, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                <TextBlock Text="{Binding Language}" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                            <PathIcon Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" Width="12" Height="12" Foreground="{DynamicResource Accent}" IsVisible="{Binding HasPersonal}"/>
                                                            <PathIcon Data="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2zM22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z" Width="12" Height="12" Foreground="{DynamicResource Info}" IsVisible="{Binding HasDocs}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0"
                                                                IsVisible="{Binding Branch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <PathIcon Data="M6 3v12M18 9a3 3 0 01-3 3H6" Width="12" Height="12" Foreground="{DynamicResource TextMuted}"/>
                                                        <TextBlock Text="{Binding Branch}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                            </DataTemplate>
                        </models:SidebarItem.ContentTemplate>
                    </models:SidebarItem>
                </controls:MultiSidebar.Items>
                </controls:MultiSidebar>

                <!-- Settings Button (bottom) -->
                <Border Grid.Row="2" ZIndex="10" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource BgTertiary}" BorderThickness="0,1,1,0">
                    <Button Width="48" Height="48" Background="Transparent" CornerRadius="0" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="Global Configuration"
                            Command="{Binding SetActiveTabCommand}"
                            CommandParameter="{x:Static models:ActiveTabType.Settings}"
                            Classes.active="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.Settings}}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource BgSecondary}"/></Style>
                            <Style Selector="Button.active">
                                <Setter Property="Background" Value="{DynamicResource BgPrimary}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                            </Style>
                        </Button.Styles>
                        <PathIcon Data="M12 15a3 3 0 100-6 3 3 0 000 6z M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"
                                  Width="20" Height="20" Foreground="{DynamicResource TextSecondary}"/>
                    </Button>
                </Border>
            </Grid>

            <!-- Main Area -->
            <Grid Grid.Column="1">
                <Grid RowDefinitions="Auto,*" Background="#111111">
                    <!-- Tab Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource BgPrimary}" BorderBrush="{DynamicResource BgTertiary}" BorderThickness="0,0,0,1" Padding="12,8,12,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="tab" Classes.active="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.TechDebt}}"
                                    Command="{Binding SetActiveTabCommand}" CommandParameter="{x:Static models:ActiveTabType.TechDebt}"
                                    Content="Tech Debt"/>
                            <Button Classes="tab" Classes.active="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.ADR}}"
                                    Command="{Binding SetActiveTabCommand}" CommandParameter="{x:Static models:ActiveTabType.ADR}"
                                    Content="ADR"/>
                            <Button Classes="tab" Classes.active="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.Specs}}"
                                    Command="{Binding SetActiveTabCommand}" CommandParameter="{x:Static models:ActiveTabType.Specs}"
                                    Content="Specs"/>
                            <Button Classes="tab" Classes.active="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.Config}}"
                                    Command="{Binding SetActiveTabCommand}" CommandParameter="{x:Static models:ActiveTabType.Config}"
                                    Content="Config"/>
                            <Button Classes="tab"
                                    Classes.active="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.Projects}}"
                                    Command="{Binding SetActiveTabCommand}" CommandParameter="{x:Static models:ActiveTabType.Projects}"
                                    Content="Projects"/>
                            <Button Classes="tab active"
                                    IsVisible="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.Settings}}"
                                    Command="{Binding SetActiveTabCommand}" CommandParameter="{x:Static models:ActiveTabType.Settings}"
                                    Content="Settings"/>

                            <!-- Dynamic document tabs (visible only when they have open docs) -->
                            <Border Width="1" Height="20" Background="{DynamicResource BgTertiary}" Margin="4,0"
                                    VerticalAlignment="Center">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                        <Binding Path="HasPersonalDocs"/>
                                        <Binding Path="HasDevelopmentDocs"/>
                                        <Binding Path="HasDocsDocs"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                            </Border>
                            <Button Classes="tab" IsVisible="{Binding HasPersonalDocs}"
                                    Classes.active="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.Personal}}"
                                    Command="{Binding SetActiveTabCommand}" CommandParameter="{x:Static models:ActiveTabType.Personal}"
                                    Content=".personal"/>
                            <Button Classes="tab" IsVisible="{Binding HasDevelopmentDocs}"
                                    Classes.active="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.Development}}"
                                    Command="{Binding SetActiveTabCommand}" CommandParameter="{x:Static models:ActiveTabType.Development}"
                                    Content=".development"/>
                            <Button Classes="tab" IsVisible="{Binding HasDocsDocs}"
                                    Classes.active="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.Docs}}"
                                    Command="{Binding SetActiveTabCommand}" CommandParameter="{x:Static models:ActiveTabType.Docs}"
                                    Content="docs"/>
                        </StackPanel>
                    </Border>

                    <!-- Tab Content -->
                    <Grid Grid.Row="1" Margin="16">

                        <!-- Tab lists and panels (visible when ShowTabList is true) -->
                        <Grid IsVisible="{Binding ShowTabList}">

                        <!-- Tech Debt Tab -->
                        <ScrollViewer IsVisible="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.TechDebt}}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="TECH DEBT" FontSize="10" Foreground="{DynamicResource TextMuted}" LetterSpacing="1" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding TechDebtItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TechDebtItemViewModel">
                                            <Border Classes="tab-list-item" PointerPressed="OnTechDebtItemClicked">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBlock Text="{Binding FileName}" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Classes="badge" Margin="8,0"
                                                            IsVisible="{Binding Priority, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                            Background="{DynamicResource WarningBg}">
                                                        <TextBlock Text="{Binding Priority}" FontSize="10" Foreground="{DynamicResource Warning}"/>
                                                    </Border>
                                                    <Border Grid.Column="2" Classes="badge"
                                                            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                            Background="{DynamicResource InfoBg}">
                                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Info}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No tech debt items found." FontSize="12" Foreground="{DynamicResource TextMuted}" FontStyle="Italic"
                                           IsVisible="{Binding !TechDebtItems.Count}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ADR Tab -->
                        <ScrollViewer IsVisible="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.ADR}}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="ARCHITECTURE DECISION RECORDS" FontSize="10" Foreground="{DynamicResource TextMuted}" LetterSpacing="1" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding AdrItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AdrItemViewModel">
                                            <Border Classes="tab-list-item" PointerPressed="OnAdrItemClicked">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No ADRs found." FontSize="12" Foreground="{DynamicResource TextMuted}" FontStyle="Italic"
                                           IsVisible="{Binding !AdrItems.Count}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Specs Tab -->
                        <ScrollViewer IsVisible="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.Specs}}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="SPECIFICATIONS" FontSize="10" Foreground="{DynamicResource TextMuted}" LetterSpacing="1" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding SpecItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SpecItemViewModel">
                                            <Border Classes="tab-list-item" PointerPressed="OnSpecItemClicked">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <Border CornerRadius="3" Padding="4,1" Background="{DynamicResource BgTertiary}" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Group}" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" Classes="badge" Margin="8,0"
                                                            IsVisible="{Binding Priority, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                            Background="{DynamicResource WarningBg}">
                                                        <TextBlock Text="{Binding Priority}" FontSize="10" Foreground="{DynamicResource Warning}"/>
                                                    </Border>
                                                    <Border Grid.Column="3" Classes="badge"
                                                            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                            Background="{DynamicResource InfoBg}">
                                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Info}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No specs found." FontSize="12" Foreground="{DynamicResource TextMuted}" FontStyle="Italic"
                                           IsVisible="{Binding !SpecItems.Count}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Projects Panel -->
                        <Grid IsVisible="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.Projects}}">
                            <views:ProjectInitializationPanel DataContext="{Binding ProjectInitializationVm}"/>
                        </Grid>

                        <!-- Settings Panel -->
                        <ScrollViewer IsVisible="{Binding ActiveTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ActiveTabType.Settings}}">
                            <StackPanel Spacing="24" MaxWidth="700">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Global Configuration" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="Application-wide settings for DevDash" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Workspaces" FontWeight="Medium" FontSize="16"/>
                                    <TextBlock Text="Manage your workspace directories." FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    <Border Background="{DynamicResource BgDeep}" CornerRadius="6" BorderBrush="{DynamicResource BgTertiary}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding NewWorkspacePath, Mode=TwoWay}" Watermark="Add new workspace path..." Background="Transparent" BorderThickness="0" Padding="12,10"/>
                                            <Button Grid.Column="1" Classes="sidebar-btn" Margin="4" Command="{Binding BrowseNewWorkspacePathCommand}" ToolTip.Tip="Browse...">
                                                <PathIcon Data="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}"/>
                                            </Button>
                                            <Button Grid.Column="2" Classes="accent" Margin="4" Padding="12,6" Command="{Binding AddWorkspaceCommand}">
                                                <TextBlock Text="Add"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding ConfiguredWorkspaces}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WorkspaceConfigViewModel">
                                                <Border Classes="project-item" Classes.selected="{Binding IsSelected}" Cursor="Hand" PointerPressed="OnWorkspaceRowClicked">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <TextBlock Text="●" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                   Foreground="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}}"/>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14"/>
                                                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextMuted}" FontFamily="Consolas,monospace" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <RadioButton Content="Coding" IsChecked="{Binding IsCoding}" GroupName="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                                <RadioButton Content="Writing" IsChecked="{Binding IsCoding, Converter={x:Static BoolConverters.Not}}" GroupName="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                            </StackPanel>
                                                            <Button Classes="sidebar-btn" Padding="4" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveWorkspaceCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove workspace">
                                                                <TextBlock Text="x" FontSize="16" Foreground="{DynamicResource Danger}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No workspaces configured. Add one above." FontSize="12" Foreground="{DynamicResource TextMuted}" FontStyle="Italic" IsVisible="{Binding !ConfiguredWorkspaces.Count}"/>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Claude Configuration Path" FontWeight="Medium"/>
                                    <TextBlock Text="Location of Claude Code configuration files (~/.claude)" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    <Border Background="{DynamicResource BgDeep}" CornerRadius="6" BorderBrush="{DynamicResource BgTertiary}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Text="{Binding ClaudeConfigPath, Mode=TwoWay}" Watermark="~/.claude" Background="Transparent" BorderThickness="0" Padding="12,10"/>
                                            <Button Grid.Column="1" Classes="sidebar-btn" Margin="4" Command="{Binding BrowseClaudeConfigPathCommand}" ToolTip.Tip="Browse...">
                                                <PathIcon Data="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Button Classes="accent" HorizontalAlignment="Left" Padding="20,10" Command="{Binding SaveSettingsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z M17 21v-8H7v8 M7 3v5h8" Width="16" Height="16"/>
                                        <TextBlock Text="Save Settings"/>
                                    </StackPanel>
                                </Button>
                                <Border Background="{DynamicResource BgSecondary}" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Configuration file:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="{Binding SettingsFilePath}" FontSize="11" Foreground="{DynamicResource TextMuted}" FontFamily="Consolas,monospace" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- No document placeholder (for list tabs only) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsVisible="{Binding SelectedDocument, Converter={x:Static ObjectConverters.IsNull}}">
                            <PathIcon Data="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8"
                                      Width="40" Height="40" Foreground="{DynamicResource BgTertiary}"/>
                            <TextBlock Text="Select an item to view" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        </Grid> <!-- end ShowTabList wrapper -->

                        <!-- Document viewer area (visible when ShowTabList is false) -->
                        <Grid RowDefinitions="Auto,Auto,Auto,*"
                              IsVisible="{Binding !ShowTabList}">

                            <!-- Document tab strip (filtered to current tab) -->
                            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding CurrentTabDocuments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DocumentTabViewModel">
                                            <Border Classes="doc-tab" Classes.selected="{Binding IsSelected}" PointerPressed="OnDocumentTabClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding FileName}" FontSize="12" VerticalAlignment="Center"/>
                                                    <Button Classes="tab-close"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseDocumentCommand}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="x" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Breadcrumb -->
                            <TextBlock Grid.Row="1" Classes="breadcrumb"
                                       Text="{Binding SelectedDocument.Breadcrumb}"
                                       Margin="0,0,0,4"/>

                            <!-- Frontmatter header -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                                        IsVisible="{Binding SelectedDocument.Frontmatter.HasData, FallbackValue=False}">
                                <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource WarningBg}"
                                        IsVisible="{Binding SelectedDocument.Frontmatter.Priority, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding SelectedDocument.Frontmatter.Priority}" FontSize="10" Foreground="{DynamicResource Warning}"/>
                                </Border>
                                <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource InfoBg}"
                                        IsVisible="{Binding SelectedDocument.Frontmatter.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding SelectedDocument.Frontmatter.Status}" FontSize="10" Foreground="{DynamicResource Info}"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedDocument.Frontmatter.Date}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                           IsVisible="{Binding SelectedDocument.Frontmatter.Date, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>

                            <!-- Markdown viewer -->
                            <Border Grid.Row="3" Background="{DynamicResource BgPrimary}" BorderBrush="{DynamicResource BgTertiary}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <md:MarkdownScrollViewer x:Name="MarkdownViewer" DataContext="{x:Null}"/>
                            </Border>
                        </Grid>

                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
