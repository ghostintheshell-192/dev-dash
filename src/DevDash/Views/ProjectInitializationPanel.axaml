<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevDash.ViewModels"
             x:Class="DevDash.Views.ProjectInitializationPanel"
             x:DataType="vm:ProjectInitializationViewModel">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="800">

            <!-- Header -->
            <StackPanel Spacing="8">
                <TextBlock Text="Initialize Project"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#e2e8f0"/>
                <TextBlock Text="Configure Claude Code for the selected project"
                           FontSize="14"
                           Foreground="#94a3b8"/>
            </StackPanel>

            <!-- No project selected message -->
            <Border Background="#1e293b"
                    CornerRadius="8"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    Padding="24"
                    IsVisible="{Binding !HasProject}">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="📂 No project selected"
                               FontSize="16"
                               Foreground="#94a3b8"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a project from the sidebar to initialize it"
                               FontSize="13"
                               Foreground="#64748b"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Project info (when project is selected) -->
            <Border Background="#0f172a"
                    CornerRadius="8"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    Padding="16"
                    IsVisible="{Binding HasProject}">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Project:"
                               Foreground="#94a3b8"
                               FontSize="13"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding ProjectName}"
                               Foreground="#e2e8f0"
                               FontSize="13"
                               FontWeight="Medium"/>

                    <Border Grid.Row="0" Grid.Column="2"
                            Background="#334155"
                            CornerRadius="4"
                            Padding="6,2"
                            IsVisible="{Binding DetectedLanguage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding DetectedLanguage}"
                                   FontSize="11"
                                   Foreground="#94a3b8"/>
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Path:"
                               Foreground="#94a3b8"
                               FontSize="13"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                               Text="{Binding ProjectPath}"
                               Foreground="#64748b"
                               FontSize="12"
                               FontFamily="monospace"/>
                </Grid>
            </Border>

            <!-- Already initialized message -->
            <Border Background="#22c55e20"
                    BorderBrush="#22c55e"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    IsVisible="{Binding IsInitialized}">
                <StackPanel Spacing="8">
                    <TextBlock Text="✓ Project Already Initialized"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#22c55e"/>
                    <TextBlock Text="This project already has Claude Code configuration in .claude/rules/"
                               FontSize="13"
                               Foreground="#86efac"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Configuration form (when project selected and not initialized) -->
            <Border Background="#0f172a"
                    CornerRadius="8"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    Padding="16"
                    IsVisible="{Binding HasProject}"
                    IsEnabled="{Binding !IsInitialized}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Project Configuration"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#e2e8f0"/>

                    <TextBlock Text="Provide information about this project (optional fields will use defaults)"
                               FontSize="13"
                               Foreground="#94a3b8"
                               TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Description:"
                                   VerticalAlignment="Center"
                                   Foreground="#94a3b8"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding ProjectDescription, Mode=TwoWay}"
                                 Watermark="Brief project description..."/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Tech Stack:"
                                   VerticalAlignment="Center"
                                   Foreground="#94a3b8"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding ProjectTechStack, Mode=TwoWay}"
                                 Watermark="e.g., .NET 8, Avalonia 11.3"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Language:"
                                   VerticalAlignment="Center"
                                   Foreground="#94a3b8"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  SelectedItem="{Binding ProjectLanguage, Mode=TwoWay}">
                            <ComboBoxItem Content="(Auto-detect)" IsSelected="True"/>
                            <ComboBoxItem Content="csharp"/>
                            <ComboBoxItem Content="python"/>
                            <ComboBoxItem Content="javascript"/>
                            <ComboBoxItem Content="typescript"/>
                            <ComboBoxItem Content="flutter"/>
                            <ComboBoxItem Content="c-cpp"/>
                            <ComboBoxItem Content="go"/>
                            <ComboBoxItem Content="rust"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Initialize button -->
            <Button Command="{Binding InitializeProjectCommand}"
                    HorizontalAlignment="Stretch"
                    Background="#3b82f6"
                    Padding="16"
                    IsVisible="{Binding HasProject}">
                <TextBlock Text="Initialize Project"
                           FontSize="14"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"/>
            </Button>

            <!-- Status message -->
            <Border Background="#22c55e20"
                    BorderBrush="#22c55e"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#22c55e"
                           FontSize="13"
                           TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
